@{
    ViewData["Title"] = "Home";

    // ----- DATA: Popular destinations -----
    var destinations = new[]
    {
        new { Name = "Paris", Country = "France", Hotels = "8,500+",
              Image = "https://images.unsplash.com/photo-1502602898657-3e91760cbb34?w=600&q=80" },
        new { Name = "Rome", Country = "Italy", Hotels = "6,200+",
              Image = "https://images.unsplash.com/photo-1552832230-c0197dd311b5?w=600&q=80" },
        new { Name = "Barcelona", Country = "Spain", Hotels = "5,800+",
              Image = "https://images.unsplash.com/photo-1583422409516-2895a77efded?w=600&q=80" },
        new { Name = "Tokyo", Country = "Japan", Hotels = "7,400+",
              Image = "https://images.unsplash.com/photo-1540959733332-eab4deabeeaf?w=600&q=80" },
        new { Name = "Dubai", Country = "UAE", Hotels = "4,300+",
              Image = "https://images.unsplash.com/photo-1512453979798-5ea266f8880c?w=600&q=80" },
        new { Name = "New York", Country = "USA", Hotels = "9,100+",
              Image = "https://images.unsplash.com/photo-1496442226666-8d4d0e62e6e9?w=600&q=80" }
    };

    // ----- DATA: Trip Inspiration -----
    var inspirations = new[]
    {
        new { Title = "Beach getaways", Subtitle = "Sun, sand, serenity", Destination = "Bali",
              Image = "https://images.unsplash.com/photo-1507525428034-b723cf961d3e?w=800&q=80",
              Tag = "Trending" },
        new { Title = "City breaks", Subtitle = "Urban adventures", Destination = "London",
              Image = "https://images.unsplash.com/photo-1513635269975-59663e0ac1ad?w=800&q=80",
              Tag = "Popular" },
        new { Title = "Family vacations", Subtitle = "Memories for all", Destination = "Orlando",
              Image = "https://images.unsplash.com/photo-1502920917128-1aa500764cbd?w=800&q=80",
              Tag = "Kid-friendly" },
        new { Title = "Romantic escapes", Subtitle = "Just the two of you", Destination = "Santorini",
              Image = "https://images.unsplash.com/photo-1570077188670-e3a8d69ac5ff?w=800&q=80",
              Tag = "Honeymoon" }
    };

    // ----- DATA: Property Types -----
    var propertyTypes = new[]
    {
        new { Name = "Hotels", Count = "1.2M+ available", Icon = "hotel" },
        new { Name = "Apartments", Count = "450K+ stays", Icon = "apartment" },
        new { Name = "Resorts", Count = "85K+ luxury", Icon = "resort" },
        new { Name = "Villas", Count = "120K+ private", Icon = "villa" }
    };
}

<!-- ========================================
     HERO
     ======================================== -->
<section class="hero">
    <div class="hero-content">
        <h1 class="hero-title">Find the perfect stay for your next trip</h1>
        <p class="hero-subtitle">
            Compare prices across international hotels. Live data, hand-picked stays, the world at your pace.
        </p>

        <form method="get" action="/Hotels" class="hero-search">
            <div class="hero-search-field">
                <span class="hero-search-icon">
                    <svg class="icon" viewBox="0 0 24 24">
                        <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                        <circle cx="12" cy="10" r="3"></circle>
                    </svg>
                </span>
                <div class="hero-search-input">
                    <label for="hero-destination">Destination</label>
                    <input type="text"
                           id="hero-destination"
                           name="destination"
                           value="Milano"
                           required />
                </div>
            </div>

            <div class="hero-search-field">
                <span class="hero-search-icon">
                    <svg class="icon" viewBox="0 0 24 24">
                        <rect x="3" y="4" width="18" height="18" rx="2"></rect>
                        <line x1="16" y1="2" x2="16" y2="6"></line>
                        <line x1="8" y1="2" x2="8" y2="6"></line>
                        <line x1="3" y1="10" x2="21" y2="10"></line>
                    </svg>
                </span>
                <div class="hero-search-input">
                    <label for="hero-arrival">Check in</label>
                    <input type="date"
                           id="hero-arrival"
                           name="arrivalDate"
                           value="@DateTime.UtcNow.AddDays(7).ToString("yyyy-MM-dd")"
                           required />
                </div>
            </div>

            <div class="hero-search-field">
                <span class="hero-search-icon">
                    <svg class="icon" viewBox="0 0 24 24">
                        <rect x="3" y="4" width="18" height="18" rx="2"></rect>
                        <line x1="16" y1="2" x2="16" y2="6"></line>
                        <line x1="8" y1="2" x2="8" y2="6"></line>
                        <line x1="3" y1="10" x2="21" y2="10"></line>
                    </svg>
                </span>
                <div class="hero-search-input">
                    <label for="hero-departure">Check out</label>
                    <input type="date"
                           id="hero-departure"
                           name="departureDate"
                           value="@DateTime.UtcNow.AddDays(10).ToString("yyyy-MM-dd")"
                           required />
                </div>
            </div>

            <div class="hero-search-field">
                <span class="hero-search-icon">
                    <svg class="icon" viewBox="0 0 24 24">
                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                        <circle cx="9" cy="7" r="4"></circle>
                    </svg>
                </span>
                <div class="hero-search-input">
                    <label for="hero-adults">Guests</label>
                    <input type="number"
                           id="hero-adults"
                           name="adults"
                           value="2"
                           min="1" max="10" />
                </div>
            </div>

            <button type="submit" class="hero-search-btn">
                <svg class="icon" viewBox="0 0 24 24">
                    <circle cx="11" cy="11" r="8"></circle>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                </svg>
                <span>Search</span>
            </button>
        </form>

        <div class="hero-features">
            <span class="hero-feature">
                <svg class="icon" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"></polyline></svg>
                International destinations
            </span>
            <span class="hero-feature">
                <svg class="icon" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"></polyline></svg>
                Best price comparison
            </span>
            <span class="hero-feature">
                <svg class="icon" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"></polyline></svg>
                Live API data
            </span>
        </div>
    </div>
</section>

<!-- ========================================
     A. POPULAR DESTINATIONS
     ======================================== -->
<section class="destinations-section">
    <div class="section-container">
        <div class="section-header">
            <h2>Popular destinations</h2>
            <p>Hand-picked cities loved by millions of travelers</p>
        </div>

        <div class="destinations-grid">
            @foreach (var dest in destinations)
            {
                <a href="/Hotels?destination=@dest.Name" class="destination-card">
                    <div class="destination-image">
                        <img src="@dest.Image" alt="@dest.Name" loading="lazy" />
                        <div class="destination-overlay"></div>
                    </div>
                    <div class="destination-info">
                        <div class="destination-name">@dest.Name</div>
                        <div class="destination-meta">
                            <span>@dest.Country</span>
                            <span class="destination-dot">·</span>
                            <span>@dest.Hotels properties</span>
                        </div>
                    </div>
                </a>
            }
        </div>
    </div>
</section>

<!-- ========================================
     C. WHY VOYAGO
     ======================================== -->
<section class="why-section">
    <div class="section-container">
        <div class="section-header">
            <h2>Why travelers choose Voyago</h2>
            <p>Built for modern travelers with intelligence and care</p>
        </div>

        <div class="why-grid">
            <div class="why-card">
                <div class="why-icon why-icon-blue">
                    <svg class="icon" viewBox="0 0 24 24">
                        <path d="M12 2L2 7l10 5 10-5-10-5z"></path>
                        <path d="M2 17l10 5 10-5"></path>
                        <path d="M2 12l10 5 10-5"></path>
                    </svg>
                </div>
                <h3>Best price guarantee</h3>
                <p>We compare millions of hotels in seconds. Find lower? We'll match it.</p>
            </div>

            <div class="why-card">
                <div class="why-icon why-icon-yellow">
                    <svg class="icon" viewBox="0 0 24 24">
                        <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
                    </svg>
                </div>
                <h3>24/7 customer support</h3>
                <p>Help is always one click away. Our concierge team is here whenever you need.</p>
            </div>

            <div class="why-card">
                <div class="why-icon why-icon-green">
                    <svg class="icon" viewBox="0 0 24 24">
                        <path d="M9 12l2 2 4-4"></path>
                        <circle cx="12" cy="12" r="10"></circle>
                    </svg>
                </div>
                <h3>Verified reviews</h3>
                <p>Every review comes from a real guest who actually stayed at the property.</p>
            </div>

            <div class="why-card">
                <div class="why-icon why-icon-purple">
                    <svg class="icon" viewBox="0 0 24 24">
                        <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline>
                    </svg>
                </div>
                <h3>Travel intelligence</h3>
                <p>Live weather, currency, news, and AI insights — all in one dashboard.</p>
            </div>
        </div>
    </div>
</section>

<!-- ========================================
     E. TRAVEL STATS
     ======================================== -->
<section class="stats-section">
    <div class="section-container">
        <div class="stats-grid">
            <div class="stat-item">
                <div class="stat-number">2M+</div>
                <div class="stat-label">Hotels worldwide</div>
            </div>
            <div class="stat-separator"></div>
            <div class="stat-item">
                <div class="stat-number">220+</div>
                <div class="stat-label">Countries covered</div>
            </div>
            <div class="stat-separator"></div>
            <div class="stat-item">
                <div class="stat-number">50M+</div>
                <div class="stat-label">Happy travelers</div>
            </div>
            <div class="stat-separator"></div>
            <div class="stat-item">
                <div class="stat-number">4.8★</div>
                <div class="stat-label">Average rating</div>
            </div>
        </div>
    </div>
</section>

<!-- ========================================
     H. TRIP INSPIRATION
     ======================================== -->
<section class="inspiration-section">
    <div class="section-container">
        <div class="section-header">
            <h2>Plan your next trip</h2>
            <p>Find the perfect stay for every kind of getaway</p>
        </div>

        <div class="inspiration-grid">
            @foreach (var inspo in inspirations)
            {
                <a href="/Hotels?destination=@inspo.Destination" class="inspiration-card">
                    <div class="inspiration-image">
                        <img src="@inspo.Image" alt="@inspo.Title" loading="lazy" />
                        <span class="inspiration-tag">@inspo.Tag</span>
                    </div>
                    <div class="inspiration-content">
                        <h3 class="inspiration-title">@inspo.Title</h3>
                        <p class="inspiration-subtitle">@inspo.Subtitle</p>
                        <span class="inspiration-link">
                            Explore
                            <svg class="icon icon-sm" viewBox="0 0 24 24">
                                <line x1="5" y1="12" x2="19" y2="12"></line>
                                <polyline points="12 5 19 12 12 19"></polyline>
                            </svg>
                        </span>
                    </div>
                </a>
            }
        </div>
    </div>
</section>

<!-- ========================================
     D. PROPERTY TYPES
     ======================================== -->
<section class="property-types-section">
    <div class="section-container">
        <div class="section-header">
            <h2>Browse by property type</h2>
            <p>From boutique hotels to private villas — find your perfect stay</p>
        </div>

        <div class="property-types-grid">
            @foreach (var type in propertyTypes)
            {
                <a href="/Hotels?destination=Paris" class="property-type-card">
                    <div class="property-type-icon">
                        @if (type.Icon == "hotel")
                        {
                            <svg class="icon" viewBox="0 0 24 24">
                                <path d="M3 21h18M5 21V7l8-4v18M19 21V11l-6-4"></path>
                                <line x1="9" y1="9" x2="9" y2="9"></line>
                                <line x1="9" y1="12" x2="9" y2="12"></line>
                                <line x1="9" y1="15" x2="9" y2="15"></line>
                                <line x1="9" y1="18" x2="9" y2="18"></line>
                            </svg>
                        }
                        else if (type.Icon == "apartment")
                        {
                            <svg class="icon" viewBox="0 0 24 24">
                                <rect x="3" y="3" width="18" height="18" rx="2"></rect>
                                <line x1="9" y1="3" x2="9" y2="21"></line>
                                <line x1="15" y1="3" x2="15" y2="21"></line>
                                <line x1="3" y1="9" x2="21" y2="9"></line>
                                <line x1="3" y1="15" x2="21" y2="15"></line>
                            </svg>
                        }
                        else if (type.Icon == "resort")
                        {
                            <svg class="icon" viewBox="0 0 24 24">
                                <path d="M12 2L4 7v6c0 5 8 9 8 9s8-4 8-9V7l-8-5z"></path>
                                <path d="M12 2v20"></path>
                            </svg>
                        }
                        else
                        {
                            <svg class="icon" viewBox="0 0 24 24">
                                <path d="M3 12l9-9 9 9"></path>
                                <path d="M5 10v10h14V10"></path>
                                <rect x="9" y="14" width="6" height="6"></rect>
                            </svg>
                        }
                    </div>
                    <div class="property-type-content">
                        <h3 class="property-type-name">@type.Name</h3>
                        <p class="property-type-count">@type.Count</p>
                    </div>
                    <div class="property-type-arrow">
                        <svg class="icon icon-sm" viewBox="0 0 24 24">
                            <polyline points="9 18 15 12 9 6"></polyline>
                        </svg>
                    </div>
                </a>
            }
        </div>
    </div>
</section>

<!-- ========================================
     DASHBOARD (existing)
     ======================================== -->
<section class="dashboard-section">
    <div class="section-header">
        <h2>Travel intelligence dashboard</h2>
        <p>Live updates from around the world to help plan your perfect trip.</p>
    </div>

    <div class="dashboard-grid">
        @await Component.InvokeAsync("WeatherCard", new { city = "Paris" })
        @await Component.InvokeAsync("CurrencyCard")
        @await Component.InvokeAsync("CryptoCard")
        @await Component.InvokeAsync("NewsCard")
        @await Component.InvokeAsync("MovieCard")
        @await Component.InvokeAsync("QuoteCard")
        @await Component.InvokeAsync("AirQualityCard", new { city = "Paris" })
        @await Component.InvokeAsync("FootballCard")

        <!-- AI Concierge (functional card) -->
        <div class="dashboard-card ai-card">
            <div class="card-header">
                <div class="card-title">
                    <div class="card-icon">
                        <svg class="icon" viewBox="0 0 24 24">
                            <rect x="3" y="11" width="18" height="10" rx="2"></rect>
                            <circle cx="12" cy="5" r="2"></circle>
                            <path d="M12 7v4"></path>
                            <line x1="8" y1="16" x2="8" y2="16"></line>
                            <line x1="16" y1="16" x2="16" y2="16"></line>
                        </svg>
                    </div>
                    <h3>AI Concierge</h3>
                </div>
                <span class="card-status">Live</span>
            </div>
            <div class="card-body ai-card-body">
                <p class="ai-card-tagline">Your personal travel assistant. Ask anything — destinations, tips, planning.</p>
                <button type="button" class="ai-card-button" data-ai-open>
                    <svg class="icon icon-sm" viewBox="0 0 24 24">
                        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                    </svg>
                    Ask Voyago AI
                </button>
                <div class="ai-card-examples">
                    <span class="ai-example-chip" data-ai-example="What's the best time to visit Paris?">
                        Best time to visit Paris?
                    </span>
                    <span class="ai-example-chip" data-ai-example="Top 5 things to do in Tokyo">
                        Top 5 in Tokyo
                    </span>
                    <span class="ai-example-chip" data-ai-example="What should I pack for a winter trip to Iceland?">
                        Pack for Iceland?
                    </span>
                </div>
            </div>
        </div>
    </div>
</section>