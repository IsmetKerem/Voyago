@{
    ViewData["Title"] = "Home";
}

<!-- HERO -->
<section class="hero">
    <div class="hero-content">
        <h1 class="hero-title">Find the perfect stay for your next trip</h1>
        <p class="hero-subtitle">
            Compare prices across international hotels. Live data, hand-picked stays, the world at your pace.
        </p>

        <form method="get" action="/Hotels" class="hero-search">
            <div class="hero-search-field">
                <span class="hero-search-icon">
                    <svg class="icon" viewBox="0 0 24 24">
                        <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                        <circle cx="12" cy="10" r="3"></circle>
                    </svg>
                </span>
                <div class="hero-search-input">
                    <label for="hero-destination">Destination</label>
                    <input type="text"
                           id="hero-destination"
                           name="destination"
                           value="Milano"
                           required />
                </div>
            </div>

            <div class="hero-search-field">
                <span class="hero-search-icon">
                    <svg class="icon" viewBox="0 0 24 24">
                        <rect x="3" y="4" width="18" height="18" rx="2"></rect>
                        <line x1="16" y1="2" x2="16" y2="6"></line>
                        <line x1="8" y1="2" x2="8" y2="6"></line>
                        <line x1="3" y1="10" x2="21" y2="10"></line>
                    </svg>
                </span>
                <div class="hero-search-input">
                    <label for="hero-arrival">Check in</label>
                    <input type="date"
                           id="hero-arrival"
                           name="arrivalDate"
                           value="@DateTime.UtcNow.AddDays(7).ToString("yyyy-MM-dd")"
                           required />
                </div>
            </div>

            <div class="hero-search-field">
                <span class="hero-search-icon">
                    <svg class="icon" viewBox="0 0 24 24">
                        <rect x="3" y="4" width="18" height="18" rx="2"></rect>
                        <line x1="16" y1="2" x2="16" y2="6"></line>
                        <line x1="8" y1="2" x2="8" y2="6"></line>
                        <line x1="3" y1="10" x2="21" y2="10"></line>
                    </svg>
                </span>
                <div class="hero-search-input">
                    <label for="hero-departure">Check out</label>
                    <input type="date"
                           id="hero-departure"
                           name="departureDate"
                           value="@DateTime.UtcNow.AddDays(10).ToString("yyyy-MM-dd")"
                           required />
                </div>
            </div>

            <div class="hero-search-field">
                <span class="hero-search-icon">
                    <svg class="icon" viewBox="0 0 24 24">
                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                        <circle cx="9" cy="7" r="4"></circle>
                    </svg>
                </span>
                <div class="hero-search-input">
                    <label for="hero-adults">Guests</label>
                    <input type="number"
                           id="hero-adults"
                           name="adults"
                           value="2"
                           min="1" max="10" />
                </div>
            </div>

            <button type="submit" class="hero-search-btn">
                <svg class="icon" viewBox="0 0 24 24">
                    <circle cx="11" cy="11" r="8"></circle>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                </svg>
                <span>Search</span>
            </button>
        </form>

        <div class="hero-features">
            <span class="hero-feature">
                <svg class="icon" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"></polyline></svg>
                International destinations
            </span>
            <span class="hero-feature">
                <svg class="icon" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"></polyline></svg>
                Best price comparison
            </span>
            <span class="hero-feature">
                <svg class="icon" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"></polyline></svg>
                Live API data
            </span>
        </div>
    </div>
</section>

<!-- DASHBOARD -->
<section class="dashboard-section">
    <div class="section-header">
        <h2>Travel intelligence dashboard</h2>
        <p>Live updates from around the world to help plan your perfect trip.</p>
    </div>

    <div class="dashboard-grid">
        @await Component.InvokeAsync("WeatherCard", new { city = "Paris" })
        @await Component.InvokeAsync("CurrencyCard")
        @await Component.InvokeAsync("CryptoCard")
        @await Component.InvokeAsync("NewsCard")
        @await Component.InvokeAsync("MovieCard")
        @await Component.InvokeAsync("QuoteCard")
        @await Component.InvokeAsync("AirQualityCard", new { city = "Paris" })
        @await Component.InvokeAsync("FootballCard")

        <!-- AI Concierge (functional card) -->
        <div class="dashboard-card ai-card">
            <div class="card-header">
                <div class="card-title">
                    <div class="card-icon">
                        <svg class="icon" viewBox="0 0 24 24">
                            <rect x="3" y="11" width="18" height="10" rx="2"></rect>
                            <circle cx="12" cy="5" r="2"></circle>
                            <path d="M12 7v4"></path>
                            <line x1="8" y1="16" x2="8" y2="16"></line>
                            <line x1="16" y1="16" x2="16" y2="16"></line>
                        </svg>
                    </div>
                    <h3>AI Concierge</h3>
                </div>
                <span class="card-status">Live</span>
            </div>
            <div class="card-body ai-card-body">
                <p class="ai-card-tagline">Your personal travel assistant. Ask anything — destinations, tips, planning.</p>
                <button type="button" class="ai-card-button" data-ai-open>
                    <svg class="icon icon-sm" viewBox="0 0 24 24">
                        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                    </svg>
                    Ask Voyago AI
                </button>
                <div class="ai-card-examples">
                    <span class="ai-example-chip" data-ai-example="What's the best time to visit Paris?">
                        Best time to visit Paris?
                    </span>
                    <span class="ai-example-chip" data-ai-example="Top 5 things to do in Tokyo">
                        Top 5 in Tokyo
                    </span>
                    <span class="ai-example-chip" data-ai-example="What should I pack for a winter trip to Iceland?">
                        Pack for Iceland?
                    </span>
                </div>
            </div>
        </div>
        
    </div>
</section>