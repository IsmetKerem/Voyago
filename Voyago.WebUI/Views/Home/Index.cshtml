@{
    ViewData["Title"] = "Home";
}

<!-- HERO -->
<section class="hero">
    <div class="hero-bg"></div>
    <div class="hero-content">
        <h1 class="hero-title">
            Find the perfect stay for your next trip
        </h1>
        <p class="hero-subtitle">
            Compare prices across international hotels. Live data, hand-picked stays, the world at your pace.
        </p>
        
        <form class="search-form" action="/Hotels" method="get">
            <div class="search-field">
                <svg class="search-field-icon icon icon-lg" viewBox="0 0 24 24">
                    <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                    <circle cx="12" cy="10" r="3"></circle>
                </svg>
                <div class="search-field-content">
                    <label class="search-label">Destination</label>
                    <input type="text" name="city" class="search-input" placeholder="Where to?" value="Milano" required />
                </div>
            </div>
            
            <div class="search-field">
                <svg class="search-field-icon icon icon-lg" viewBox="0 0 24 24">
                    <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                    <line x1="16" y1="2" x2="16" y2="6"></line>
                    <line x1="8" y1="2" x2="8" y2="6"></line>
                    <line x1="3" y1="10" x2="21" y2="10"></line>
                </svg>
                <div class="search-field-content">
                    <label class="search-label">Check in</label>
                    <input type="date" name="checkIn" class="search-input" required />
                </div>
            </div>
            
            <div class="search-field">
                <svg class="search-field-icon icon icon-lg" viewBox="0 0 24 24">
                    <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                    <line x1="16" y1="2" x2="16" y2="6"></line>
                    <line x1="8" y1="2" x2="8" y2="6"></line>
                    <line x1="3" y1="10" x2="21" y2="10"></line>
                </svg>
                <div class="search-field-content">
                    <label class="search-label">Check out</label>
                    <input type="date" name="checkOut" class="search-input" required />
                </div>
            </div>
            
            <div class="search-field">
                <svg class="search-field-icon icon icon-lg" viewBox="0 0 24 24">
                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                    <circle cx="9" cy="7" r="4"></circle>
                    <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                    <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                </svg>
                <div class="search-field-content">
                    <label class="search-label">Guests</label>
                    <select name="guests" class="search-input">
                        <option value="1">1 guest</option>
                        <option value="2" selected>2 guests</option>
                        <option value="3">3 guests</option>
                        <option value="4">4 guests</option>
                    </select>
                </div>
            </div>
            
            <button type="submit" class="search-submit">
                <svg class="icon" viewBox="0 0 24 24">
                    <circle cx="11" cy="11" r="8"></circle>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                </svg>
                Search
            </button>
        </form>
        
        <div class="hero-trust">
            <div class="trust-item">
                <svg class="icon" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"></polyline></svg>
                International destinations
            </div>
            <div class="trust-item">
                <svg class="icon" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"></polyline></svg>
                Best price comparison
            </div>
            <div class="trust-item">
                <svg class="icon" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"></polyline></svg>
                Live API data
            </div>
        </div>
    </div>
</section>

<!-- DASHBOARD -->
<section class="dashboard-section">
    <div class="section-header">
        <h2>Travel intelligence dashboard</h2>
        <p>Live updates from around the world to help plan your perfect trip.</p>
    </div>
    
    <div class="dashboard-grid">
        @await Component.InvokeAsync("WeatherCard", new { city = "Paris" })
        
        @await Component.InvokeAsync("CurrencyCard")
        
        @await Component.InvokeAsync("CryptoCard")
        
        @await Component.InvokeAsync("NewsCard")
        
        @await Component.InvokeAsync("MovieCard")
        
        
        <!-- Country -->
        <div class="dashboard-card placeholder-card">
            <div class="card-header">
                <div class="card-title">
                    <div class="card-icon">
                        <svg class="icon" viewBox="0 0 24 24">
                            <circle cx="12" cy="12" r="10"></circle>
                            <line x1="2" y1="12" x2="22" y2="12"></line>
                            <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
                        </svg>
                    </div>
                    <h3>Country info</h3>
                </div>
            </div>
            <div class="card-body placeholder-body">
                <div class="placeholder-label">Coming soon</div>
                <div class="placeholder-status">Capital · currency · language</div>
            </div>
        </div>
        
        <!-- World Time -->
        <div class="dashboard-card placeholder-card">
            <div class="card-header">
                <div class="card-title">
                    <div class="card-icon">
                        <svg class="icon" viewBox="0 0 24 24">
                            <circle cx="12" cy="12" r="10"></circle>
                            <polyline points="12 6 12 12 16 14"></polyline>
                        </svg>
                    </div>
                    <h3>World time</h3>
                </div>
            </div>
            <div class="card-body placeholder-body">
                <div class="placeholder-label">Coming soon</div>
                <div class="placeholder-status">Time across time zones</div>
            </div>
        </div>
        
        <!-- Football -->
        <div class="dashboard-card placeholder-card">
            <div class="card-header">
                <div class="card-title">
                    <div class="card-icon">
                        <svg class="icon" viewBox="0 0 24 24">
                            <circle cx="12" cy="12" r="10"></circle>
                            <path d="M12 2v20M2 12h20"></path>
                        </svg>
                    </div>
                    <h3>Football</h3>
                </div>
            </div>
            <div class="card-body placeholder-body">
                <div class="placeholder-label">Coming soon</div>
                <div class="placeholder-status">Match scores and standings</div>
            </div>
        </div>
        
        <!-- AI -->
        <div class="dashboard-card placeholder-card">
            <div class="card-header">
                <div class="card-title">
                    <div class="card-icon">
                        <svg class="icon" viewBox="0 0 24 24">
                            <rect x="3" y="11" width="18" height="10" rx="2"></rect>
                            <circle cx="12" cy="5" r="2"></circle>
                            <path d="M12 7v4"></path>
                            <line x1="8" y1="16" x2="8" y2="16"></line>
                            <line x1="16" y1="16" x2="16" y2="16"></line>
                        </svg>
                    </div>
                    <h3>AI Concierge</h3>
                </div>
            </div>
            <div class="card-body placeholder-body">
                <div class="placeholder-label">Coming soon</div>
                <div class="placeholder-status">Smart travel suggestions</div>
            </div>
        </div>
    </div>
</section>