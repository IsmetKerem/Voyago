<!-- ========================================
     HERO
     ======================================== -->
<section class="hero">
    <div class="hero-content">
        <h1 class="hero-title">Find the perfect stay for your next trip</h1>
        <p class="hero-subtitle">
            Compare prices across international hotels. Live data, hand-picked stays, the world at your pace.
        </p>

        <form method="get" action="/Hotels" class="hero-search">
            <div class="hero-search-field">
                <span class="hero-search-icon">
                    <svg class="icon" viewBox="0 0 24 24">
                        <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                        <circle cx="12" cy="10" r="3"></circle>
                    </svg>
                </span>
                <div class="hero-search-input">
                    <label for="hero-destination">Destination</label>
                    <input type="text" id="hero-destination" name="destination" value="Milano" required />
                </div>
            </div>

            <div class="hero-search-field">
                <span class="hero-search-icon">
                    <svg class="icon" viewBox="0 0 24 24">
                        <rect x="3" y="4" width="18" height="18" rx="2"></rect>
                        <line x1="16" y1="2" x2="16" y2="6"></line>
                        <line x1="8" y1="2" x2="8" y2="6"></line>
                        <line x1="3" y1="10" x2="21" y2="10"></line>
                    </svg>
                </span>
                <div class="hero-search-input">
                    <label for="hero-arrival">Check in</label>
                    <input type="date" id="hero-arrival" name="arrivalDate"
                           value="@DateTime.UtcNow.AddDays(7).ToString("yyyy-MM-dd")" required />
                </div>
            </div>

            <div class="hero-search-field">
                <span class="hero-search-icon">
                    <svg class="icon" viewBox="0 0 24 24">
                        <rect x="3" y="4" width="18" height="18" rx="2"></rect>
                        <line x1="16" y1="2" x2="16" y2="6"></line>
                        <line x1="8" y1="2" x2="8" y2="6"></line>
                        <line x1="3" y1="10" x2="21" y2="10"></line>
                    </svg>
                </span>
                <div class="hero-search-input">
                    <label for="hero-departure">Check out</label>
                    <input type="date" id="hero-departure" name="departureDate"
                           value="@DateTime.UtcNow.AddDays(10).ToString("yyyy-MM-dd")" required />
                </div>
            </div>

            <div class="hero-search-field">
                <span class="hero-search-icon">
                    <svg class="icon" viewBox="0 0 24 24">
                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                        <circle cx="9" cy="7" r="4"></circle>
                    </svg>
                </span>
                <div class="hero-search-input">
                    <label for="hero-adults">Guests</label>
                    <input type="number" id="hero-adults" name="adults" value="2" min="1" max="10" />
                </div>
            </div>

            <button type="submit" class="hero-search-btn">
                <svg class="icon" viewBox="0 0 24 24">
                    <circle cx="11" cy="11" r="8"></circle>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                </svg>
                <span>Search</span>
            </button>
        </form>

        <div class="hero-features">
            <span class="hero-feature">
                <svg class="icon" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"></polyline></svg>
                International destinations
            </span>
            <span class="hero-feature">
                <svg class="icon" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"></polyline></svg>
                Best price comparison
            </span>
            <span class="hero-feature">
                <svg class="icon" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"></polyline></svg>
                Live API data
            </span>
        </div>
    </div>
</section>

<!-- ========================================
     ⭐ DASHBOARD
     ======================================== -->
<section class="dashboard-section">
    <div class="section-header">
        <h2>Travel intelligence dashboard</h2>
        <p>Live updates from around the world to help plan your perfect trip.</p>
    </div>

    <div class="dashboard-grid">
        @await Component.InvokeAsync("WeatherCard", new { city = "Paris" })
        @await Component.InvokeAsync("CurrencyCard")
        @await Component.InvokeAsync("CryptoCard")
        @await Component.InvokeAsync("NewsCard")
        @await Component.InvokeAsync("MovieCard")
        @await Component.InvokeAsync("QuoteCard")
        @await Component.InvokeAsync("AirQualityCard", new { city = "Paris" })
        @await Component.InvokeAsync("FootballCard")

        <div class="dashboard-card ai-card">
            <div class="card-header">
                <div class="card-title">
                    <div class="card-icon">
                        <svg class="icon" viewBox="0 0 24 24">
                            <rect x="3" y="11" width="18" height="10" rx="2"></rect>
                            <circle cx="12" cy="5" r="2"></circle>
                            <path d="M12 7v4"></path>
                        </svg>
                    </div>
                    <h3>AI Concierge</h3>
                </div>
                <span class="card-status">Live</span>
            </div>
            <div class="card-body ai-card-body">
                <p class="ai-card-tagline">Your personal travel assistant. Ask anything — destinations, tips, planning.</p>
                <button type="button" class="ai-card-button" data-ai-open>
                    <svg class="icon icon-sm" viewBox="0 0 24 24">
                        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                    </svg>
                    Ask Voyago AI
                </button>
                <div class="ai-card-examples">
                    <span class="ai-example-chip" data-ai-example="What's the best time to visit Paris?">Best time to visit Paris?</span>
                    <span class="ai-example-chip" data-ai-example="Top 5 things to do in Tokyo">Top 5 in Tokyo</span>
                    <span class="ai-example-chip" data-ai-example="What should I pack for a winter trip to Iceland?">Pack for Iceland?</span>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ========================================
     A. POPULAR DESTINATIONS
     ======================================== -->
<section class="destinations-section">
    <div class="section-container">
        <div class="section-header">
            <h2>Popular destinations</h2>
            <p>Hand-picked cities loved by millions of travelers</p>
        </div>

        <div class="destinations-grid">
            @foreach (var dest in destinations)
            {
                <a href="/Hotels?destination=@dest.Name" class="destination-card">
                    <div class="destination-image">
                        <img src="@dest.Image" alt="@dest.Name" loading="lazy" />
                        <div class="destination-overlay"></div>
                    </div>
                    <div class="destination-info">
                        <div class="destination-name">@dest.Name</div>
                        <div class="destination-meta">
                            <span>@dest.Country</span>
                            <span class="destination-dot">·</span>
                            <span>@dest.Hotels properties</span>
                        </div>
                    </div>
                </a>
            }
        </div>
    </div>
</section>

<!-- ========================================
     B. FEATURED HOTELS
     ======================================== -->
<section class="featured-hotels-section">
    <div class="section-container">
        <div class="section-header section-header-row">
            <div>
                <h2>Featured hotels</h2>
                <p>Hand-picked stays from around the world</p>
            </div>
            <a href="/Hotels?destination=Paris" class="section-link">
                View all
                <svg class="icon icon-sm" viewBox="0 0 24 24">
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
            </a>
        </div>

        <div class="featured-hotels-grid">
            @foreach (var hotel in featuredHotels)
            {
                <a href="/Hotels?destination=@hotel.City.Split(',')[0].Trim()" class="featured-hotel-card">
                    <div class="featured-hotel-image">
                        <img src="@hotel.Image" alt="@hotel.Name" loading="lazy" />
                        <span class="featured-hotel-badge">@hotel.Badge</span>
                    </div>
                    <div class="featured-hotel-info">
                        <div class="featured-hotel-stars">
                            @for (int i = 0; i < hotel.Stars; i++)
                            {
                                <svg class="icon icon-sm" viewBox="0 0 24 24" fill="currentColor" stroke="none">
                                    <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                                </svg>
                            }
                        </div>
                        <h3 class="featured-hotel-name">@hotel.Name</h3>
                        <p class="featured-hotel-city">@hotel.City</p>
                        <div class="featured-hotel-footer">
                            <div class="featured-hotel-rating">
                                <span class="featured-hotel-score">@hotel.Rating</span>
                                <span class="featured-hotel-reviews">@hotel.Reviews reviews</span>
                            </div>
                            <div class="featured-hotel-price">
                                <span class="featured-hotel-price-amount">@hotel.Price</span>
                                <span class="featured-hotel-price-note">per night</span>
                            </div>
                        </div>
                    </div>
                </a>
            }
        </div>
    </div>
</section>

