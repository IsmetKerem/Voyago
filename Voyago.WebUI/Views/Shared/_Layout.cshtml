<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Voyago</title>
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;1,9..144,400&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
    
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
@await Html.PartialAsync("_Navbar")
    
<main>
    @RenderBody()
</main>
    
@await Html.PartialAsync("_Footer")
<!-- AI Modal -->
<div class="ai-modal" id="ai-modal" hidden>
    <div class="ai-modal-overlay" data-ai-close></div>
    <div class="ai-modal-content">
        <div class="ai-modal-header">
            <div class="ai-modal-title">
                <div class="ai-modal-icon">
                    <svg class="icon" viewBox="0 0 24 24">
                        <rect x="3" y="11" width="18" height="10" rx="2"></rect>
                        <circle cx="12" cy="5" r="2"></circle>
                        <path d="M12 7v4"></path>
                    </svg>
                </div>
                <div>
                    <h3>Voyago AI</h3>
                    <p>Your personal travel assistant</p>
                </div>
            </div>
            <button type="button" class="ai-modal-close" data-ai-close aria-label="Close">
                <svg class="icon" viewBox="0 0 24 24">
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
            </button>
        </div>

        <div class="ai-modal-body" id="ai-modal-body">
            <div class="ai-welcome">
                <p>Hi! Ask me anything about travel — destinations, planning, tips, hotels.</p>
            </div>
        </div>

        <form class="ai-modal-form" id="ai-modal-form">
            <textarea
                id="ai-input"
                class="ai-input"
                placeholder="Ask anything about travel..."
                rows="2"
                maxlength="500"
                required></textarea>
            <button type="submit" class="ai-submit-btn" id="ai-submit-btn">
                <span class="ai-submit-text">Ask</span>
                <svg class="icon icon-sm ai-submit-icon" viewBox="0 0 24 24">
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
                <span class="ai-spinner" hidden></span>
            </button>
        </form>
    </div>
</div>

<!-- AI Modal JavaScript -->
<script src="~/js/ai-modal.js" asp-append-version="true"></script>
</body>
</html>