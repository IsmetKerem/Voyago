@model List<Voyago.WebUI.Dtos.NewsDto>

<div class="dashboard-card news-card">
    <div class="card-header">
        <div class="card-title">
            <div class="card-icon">
                <svg class="icon" viewBox="0 0 24 24">
                    <path d="M4 22h16a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2H8a2 2 0 0 0-2 2v16a2 2 0 0 1-2 2zm0 0a2 2 0 0 1-2-2v-9c0-1.1.9-2 2-2h2"></path>
                    <path d="M18 14h-8"></path>
                    <path d="M15 18h-5"></path>
                    <path d="M10 6h8v4h-8V6z"></path>
                </svg>
            </div>
            <h3>World News</h3>
        </div>
        @if (Model is not null && Model.Any())
        {
            <span class="card-status">Live</span>
        }
    </div>
    <div class="card-body">
        @if (Model is null || !Model.Any())
        {
            <p class="error-state">Data currently unavailable.</p>
        }
        else
        {
            <ul class="news-list">
                @foreach (var item in Model)
                {
                    var thumb = !string.IsNullOrWhiteSpace(item.ThumbnailUrl)
                        ? item.ThumbnailUrl
                        : item.PhotoUrl;

                    <li class="news-item">
                        @if (!string.IsNullOrWhiteSpace(thumb))
                        {
                            <img src="@thumb" alt="" class="news-thumb" loading="lazy" />
                        }
                        else
                        {
                            <div class="news-thumb news-thumb-fallback">
                                <svg class="icon" viewBox="0 0 24 24">
                                    <rect x="3" y="3" width="18" height="18" rx="2"></rect>
                                    <circle cx="9" cy="9" r="2"></circle>
                                    <path d="M21 15l-5-5L5 21"></path>
                                </svg>
                            </div>
                        }
                        <div class="news-content">
                            <a href="@item.Link" target="_blank" rel="noopener" class="news-title">
                                @item.Title
                            </a>
                            <div class="news-meta">
                                <span class="news-source">@item.SourceName</span>
                                <span class="news-dot">·</span>
                                <span class="news-time">@item.PublishedAgo</span>
                            </div>
                        </div>
                    </li>
                }
            </ul>
        }
    </div>
</div>