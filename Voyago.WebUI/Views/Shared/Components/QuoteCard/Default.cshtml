@model List<Voyago.WebUI.Dtos.QuoteDto>

<div class="dashboard-card quote-card">
    <div class="card-header">
        <div class="card-title">
            <div class="card-icon">
                <svg class="icon" viewBox="0 0 24 24">
                    <path d="M3 21c3 0 7-1 7-8V5c0-1.25-.756-2.017-2-2H4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2 1 0 1 0 1 1v1c0 1-1 2-2 2s-1 .008-1 1.031V20c0 1 0 1 1 1z"></path>
                    <path d="M15 21c3 0 7-1 7-8V5c0-1.25-.757-2.017-2-2h-4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2h.75c0 2.25.25 4-2.75 4v3c0 1 0 1 1 1z"></path>
                </svg>
            </div>
            <h3>Daily inspiration</h3>
        </div>
        @if (Model is not null && Model.Any())
        {
            <span class="card-status">Live</span>
        }
    </div>
    <div class="card-body">
        @if (Model is null || !Model.Any())
        {
            <p class="error-state">Data currently unavailable.</p>
        }
        else
        {
            <ul class="quote-list">
                @foreach (var quote in Model)
                {
                    <li class="quote-item">
                        <blockquote class="quote-text">@quote.Text</blockquote>
                        <div class="quote-meta">
                            <span class="quote-author">— @quote.Author</span>
                            @if (!string.IsNullOrWhiteSpace(quote.CategoryFormatted))
                            {
                                <span class="quote-category">@quote.CategoryFormatted</span>
                            }
                        </div>
                    </li>
                }
            </ul>
        }
    </div>
</div>