@model Voyago.WebUI.Dtos.CurrencyDto

<div class="dashboard-card currency-card">
    <div class="card-header">
        <div class="card-title">
            <div class="card-icon">
                <svg class="icon" viewBox="0 0 24 24">
                    <line x1="12" y1="1" x2="12" y2="23"></line>
                    <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
                </svg>
            </div>
            <h3>Currency</h3>
        </div>
        @if (Model is not null)
        {
            <span class="card-status">Live</span>
        }
    </div>
    <div class="card-body">
        @if (Model is null)
        {
            <p class="error-state">Data currently unavailable.</p>
        }
        else
        {
            <div class="currency-base">1 @Model.BaseCurrency equals</div>
            <ul class="currency-list">
                @foreach (var rate in Model.Rates)
                {
                    <li class="currency-item">
                        <span class="currency-code">
                            <span class="currency-symbol">@rate.Symbol</span>
                            @rate.Code
                        </span>
                        <span class="currency-rate">@rate.Rate.ToString("0.0000")</span>
                    </li>
                }
            </ul>
        }
    </div>
</div>