@model Voyago.WebUI.Dtos.HotelSearchResponseDto

@{
    ViewData["Title"] = "Hotels";
    var searchRequest = ViewBag.SearchRequest as Voyago.WebUI.Dtos.HotelSearchRequest;
}

<div class="hotels-page">
    <!-- Top search bar -->
    <div class="hotels-search-bar">
        <form method="get" action="/Hotels" class="hotels-search-form">
            <div class="hotels-search-field">
                <label for="destination">Destination</label>
                <input type="text"
                       id="destination"
                       name="destination"
                       value="@searchRequest?.Destination"
                       placeholder="Where to?"
                       required />
            </div>
            <div class="hotels-search-field">
                <label for="arrivalDate">Check in</label>
                <input type="date"
                       id="arrivalDate"
                       name="arrivalDate"
                       value="@searchRequest?.ArrivalDate"
                       required />
            </div>
            <div class="hotels-search-field">
                <label for="departureDate">Check out</label>
                <input type="date"
                       id="departureDate"
                       name="departureDate"
                       value="@searchRequest?.DepartureDate"
                       required />
            </div>
            <div class="hotels-search-field">
                <label for="adults">Adults</label>
                <input type="number"
                       id="adults"
                       name="adults"
                       value="@(searchRequest?.Adults ?? 2)"
                       min="1" max="10"
                       required />
            </div>
            <div class="hotels-search-field">
                <label for="rooms">Rooms</label>
                <input type="number"
                       id="rooms"
                       name="rooms"
                       value="@(searchRequest?.Rooms ?? 1)"
                       min="1" max="5"
                       required />
            </div>
            <button type="submit" class="btn-search">
                <svg class="icon" viewBox="0 0 24 24">
                    <circle cx="11" cy="11" r="8"></circle>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                </svg>
                <span>Search</span>
            </button>
        </form>
    </div>

    <!-- Main: sidebar + results -->
    <div class="hotels-layout">
        <aside class="hotels-sidebar">
            <h3 class="hotels-sidebar-title">Filters</h3>
            <p class="hotels-sidebar-placeholder">
                Filters coming soon — narrow down results by price, stars, and review score.
            </p>
        </aside>

        <main class="hotels-results">
            @if (Model is null)
            {
                <div class="hotels-empty">
                    <h2>Search failed</h2>
                    <p>Something went wrong. Please try again.</p>
                </div>
            }
            else if (Model.Hotels.Count == 0)
            {
                <div class="hotels-empty">
                    <h2>No hotels found</h2>
                    <p>Try a different destination or adjust your dates.</p>
                </div>
            }
            else
            {
                <div class="hotels-header">
                    <h1 class="hotels-title">@Model.DestinationName</h1>
                    <p class="hotels-count">@Model.TotalCount properties found</p>
                </div>

                <div class="hotels-list">
                    @foreach (var hotel in Model.Hotels)
                    {
                        @await Html.PartialAsync("_HotelCard", hotel)
                    }
                </div>

                @if (Model.HasNextPage)
                {
                    <div class="hotels-pagination">
                        <a class="btn-pagination" href="@Url.Action("Index", new {
                            destination = searchRequest?.Destination,
                            arrivalDate = searchRequest?.ArrivalDate,
                            departureDate = searchRequest?.DepartureDate,
                            adults = searchRequest?.Adults,
                            children = searchRequest?.Children,
                            rooms = searchRequest?.Rooms,
                            pageNumber = (searchRequest?.PageNumber ?? 1) + 1
                        })">
                            Load more results
                        </a>
                    </div>
                }
            }
        </main>
    </div>
</div>